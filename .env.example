# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
PROJECT_NAME="Multimodal HDSD Chatbot Assistant"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# ==============================================================================
# QWEN LLM / DASHSCOPE API SETTINGS
# ==============================================================================
QWEN_API_KEY="sk-your-qwen-or-dashscope-api-key-here"
QWEN_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
QWEN_MODEL_NAME="qwen3.7-flash"
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.5
LLM_MAX_TOKENS=2048

# ==============================================================================
# EMBEDDING & HUGGING FACE SPACE MICROSERVICE SETTINGS
# ==============================================================================
EMBEDDING_MODEL_NAME="AITeamVN/Vietnamese_Embedding_v2"
EMBEDDING_DIMENSION=1024
HF_SPACE_URL="https://hf.co/spaces/Nato1306/vietnamese-embedding-api"
HF_EMBEDDING_API_URL="https://nato1306-vietnamese-embedding-api.hf.space"
USE_REMOTE_EMBEDDING=false

# ==============================================================================
# CLOUD DATABASE & SUPABASE POSTGRESQL SETTINGS
# ==============================================================================
DATABASE_URL="postgresql://postgres:cEzQV7AuXRXnmxGb@db.tykwgiubhnxedlpxszdn.supabase.co:5432/postgres"
SUPABASE_URL="https://tykwgiubhnxedlpxszdn.supabase.co"
SUPABASE_PASS="cEzQV7AuXRXnmxGb"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# ==============================================================================
# VECTOR DATABASE SETTINGS
# ==============================================================================
VECTOR_DB_TYPE="chroma" # "chroma", "qdrant", hoặc "pgvector"
CHROMA_PERSIST_DIRECTORY="./chroma_data"
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION="hdsd_chunks"

# ==============================================================================
# STORAGE & CDN SETTINGS
# ==============================================================================
IMAGE_STORAGE_PATH="./data/extracted_images"
BASE_IMAGE_CDN_URL="http://localhost:8000/static/images"

# ==============================================================================
# REDIS CACHE SETTINGS
# ==============================================================================
REDIS_ENABLED=false
REDIS_HOST="localhost"
REDIS_PORT=6379

# ==============================================================================
# CORS & DEPLOYMENT SETTINGS
# ==============================================================================
GITHUB_REPO_URL="https://github.com/CaoAnhNato/Chatbot_HDSD.git"
VERCEL_FRONTEND_URL="https://chatbot-hdsd.vercel.app"
RAILWAY_BACKEND_URL="https://chatbothdsd-production.up.railway.app"
CORS_ORIGINS="http://localhost:3000,https://chatbot-hdsd.vercel.app,https://chatbothdsd-production.up.railway.app"
